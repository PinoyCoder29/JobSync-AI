generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ExperienceKind {
  WORK
  INTERNSHIP
}

enum InterviewCategory {
  HR
  BEHAVIORAL
  TECHNICAL
  SITUATIONAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum ProfileVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  PRIVATE
}

// BLOCKED is intentionally NOT a connection state: blocking is its own relationship (see Block).
enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Follow targets are polymorphic so companies/topics can reuse the same table later.
enum FollowTargetType {
  USER
  COMPANY
  TOPIC
}

enum MediaKind {
  USER_AVATAR
  USER_COVER
  POST
  COMPANY_LOGO
  COMPANY_COVER
  PROJECT
  COMMUNITY
  EVENT
  MESSAGE
}

// ───────── Social feed ─────────

enum PostVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  PRIVATE
}

enum PostType {
  TEXT
  IMAGE
  JOB
  PROJECT
  ACHIEVEMENT
  CAREER_UPDATE
  LINK
  // Future: POLL, EVENT, ARTICLE
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
  CURIOUS
}

enum ReportTargetType {
  POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  FOLLOWED
  POST_REACTION
  POST_COMMENT
  COMMENT_REPLY
  POST_SHARED
  JOB_RECOMMENDED
  JOB_ALERT_MATCH
  APPLICATION_STATUS
  MENTION
  MESSAGE
}

enum FeaturedCategory {
  FEATURED_JOB
  FEATURED_COMPANY
  FEATURED_PERSON
  FEATURED_POST
  FEATURED_SKILL
  FEATURED_LEARNING
  FEATURED_EVENT
}

enum FeaturedStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ───────── Auth.js (Prisma Adapter) ─────────

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  resume            Resume?
  skills            UserSkill[]
  savedJobs         SavedJob[]
  applications      Application[]
  interviewSessions InterviewSession[]
  resumeAnalyses    ResumeAnalysis[]
  atsAnalyses       ATSAnalysis[]
  jobMatches        JobMatch[]
  media             Media[]
  connectionsSent     Connection[]      @relation("ConnectionRequester")
  connectionsReceived Connection[]      @relation("ConnectionAddressee")
  follows             Follow[]          @relation("FollowFollower")
  blocksCreated       Block[]           @relation("BlockBlocker")
  blocksReceived      Block[]           @relation("BlockBlocked")
  posts               Post[]
  postReactions       PostReaction[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  savedPosts          SavedPost[]
  reportsFiled        ContentReport[]   @relation("ReportReporter")
  notificationsReceived Notification[]  @relation("NotificationRecipient")
  notificationsSent   Notification[]    @relation("NotificationActor")
  jobAlerts           JobAlert[]
  conversationParticipations ConversationParticipant[]
  messagesSent        Message[]
  messageReactions    MessageReaction[]
  messagesHidden      MessageHidden[]
  // Presence: refreshed by a throttled heartbeat while the app is open. Shown only if the user allows it (Profile.showOnlineStatus).
  lastSeenAt          DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ───────── Profile & skills ─────────

model Profile {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  headline                 String?
  summary                  String?          @db.Text
  location                 String?
  targetRoles              String[]
  preferredWorkArrangement WorkArrangement?
  preferredLocations       String[]
  salaryExpectationMin     Int?
  salaryExpectationMax     Int?
  portfolioUrl             String?
  githubUrl                String?
  linkedinUrl              String?
  // Settings (stored now, delivery/enforcement wired up later)
  notifyApplicationUpdates Boolean          @default(true)
  notifyJobAlerts          Boolean          @default(true)
  notifyProductNews        Boolean          @default(false)
  // Social notification preferences (checked before a notification row is created)
  notifyReactions          Boolean          @default(true)
  notifyComments           Boolean          @default(true)
  notifyConnections        Boolean          @default(true)
  notifyMessages           Boolean          @default(true)
  profileVisible           Boolean          @default(true)
  // Presence privacy: when false, nobody sees this user's online/last-active status (and they don't see others').
  showOnlineStatus         Boolean          @default(true)
  // Network privacy. `profileVisible = false` is still honoured and always means PRIVATE.
  visibility               ProfileVisibility @default(PUBLIC)
  avatarMediaId            String?
  coverMediaId             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia              Media?           @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia               Media?           @relation("ProfileCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([visibility])
}

model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  category     String?
  userSkills   UserSkill[]
  jobSkills    JobSkill[]
  resumeSkills ResumeSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  level   Int    @default(3) // 1 (beginner) – 5 (expert)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

// ───────── Resume (normalized) ─────────

model Resume {
  id             String                @id @default(cuid())
  userId         String                @unique
  title          String                @default("My Resume")
  fullName       String
  email          String
  phone          String                @default("")
  location       String                @default("")
  headline       String                @default("") // job title shown under the name
  githubUrl      String                @default("")
  linkedinUrl    String                @default("")
  portfolioUrl   String                @default("")
  summary        String                @default("") @db.Text
  hasExperience  Boolean? // null = not answered yet, false = fresh graduate path
  lastStep       String? // wizard progress, so the user resumes where they stopped
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences    ResumeExperience[]
  trainings      ResumeTraining[]
  education      ResumeEducation[]
  projects       ResumeProject[]
  certifications ResumeCertification[]
  skills         ResumeSkill[]
  analyses       ResumeAnalysis[]
  atsAnalyses    ATSAnalysis[]
}

model ResumeExperience {
  id          String @id @default(cuid())
  resumeId    String
  kind        ExperienceKind @default(WORK)
  company     String
  role        String
  department  String @default("")
  location    String @default("")
  startDate   String // "YYYY-MM"
  endDate     String @default("") // empty = present
  description String @default("") @db.Text
  sortOrder   Int    @default(0)
  resume      Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, kind])
}

model ResumeEducation {
  id          String @id @default(cuid())
  resumeId    String
  school      String
  degree      String
  field       String @default("")
  location    String @default("")
  honors      String @default("")
  startDate   String @default("")
  endDate     String @default("")
  description String @default("") @db.Text
  sortOrder   Int    @default(0)
  resume      Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeProject {
  id           String @id @default(cuid())
  resumeId     String
  name         String
  role         String @default("")
  organization String @default("")
  date         String @default("")
  url          String @default("")
  description  String @default("") @db.Text
  technologies String @default("")
  sortOrder    Int    @default(0)
  resume       Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeCertification {
  id         String @id @default(cuid())
  resumeId   String
  name       String
  issuer     String @default("")
  issuedDate     String @default("")
  expirationDate String @default("")
  credentialId   String @default("")
  url        String @default("")
  sortOrder  Int    @default(0)
  resume     Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeTraining {
  id          String @id @default(cuid())
  resumeId    String
  name        String
  provider    String @default("")
  date        String @default("")
  description String @default("") @db.Text
  sortOrder   Int    @default(0)
  resume      Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkill {
  id        String @id @default(cuid())
  resumeId  String
  skillId   String
  category  String @default("Other")
  sortOrder Int    @default(0)
  resume    Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resumeId, skillId])
}

// ───────── Jobs ─────────

model Job {
  id                 String          @id @default(cuid())
  title              String
  company            String
  companyDescription String          @default("") @db.Text
  location           String
  workArrangement    WorkArrangement
  employmentType     EmploymentType
  experienceLevel    ExperienceLevel
  salaryMin          Int?
  salaryMax          Int?
  currency           String          @default("PHP")
  description        String          @db.Text
  responsibilities   String[]
  requirements       String[]
  preferred          String[]
  benefits           String[]
  postedAt           DateTime        @default(now())
  isActive           Boolean         @default(true)
  // Prepared for a future external job provider
  source             String          @default("database")
  externalId         String?
  skills             JobSkill[]
  savedBy            SavedJob[]
  applications       Application[]
  matches            JobMatch[]
  atsAnalyses        ATSAnalysis[]

  postsAbout         Post[]

  @@unique([source, externalId])
  @@index([title])
  @@index([location])
  @@index([postedAt])
  @@index([isActive, postedAt])
  @@index([workArrangement])
  @@index([employmentType])
  @@index([experienceLevel])
  @@index([company])
}

model JobSkill {
  id       String  @id @default(cuid())
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

// ───────── Applications ─────────

model Application {
  id        String                      @id @default(cuid())
  userId    String
  jobId     String?
  company   String
  position  String
  status    ApplicationStatus           @default(APPLIED)
  appliedAt DateTime                    @default(now())
  nextStep  String?
  notes     String?                     @db.Text
  jobUrl    String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  history   ApplicationStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  note          String?
  changedAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ───────── Interview prep ─────────

model InterviewSession {
  id          String              @id @default(cuid())
  userId      String
  category    InterviewCategory
  jobRole     String
  difficulty  Difficulty
  status      InterviewStatus     @default(IN_PROGRESS)
  score       Int?
  // CLASSIC = fixed question set (original). LIVE = AI interviewer that adapts to each answer.
  mode        String              @default("CLASSIC")
  focus       String?             // e.g. "Frontend Developer"
  jobId       String?
  jobDescription String?          @db.Text
  maxQuestions Int                @default(0)
  report      Json?               // final structured evaluation (LIVE)
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   InterviewQuestion[]

  @@index([userId, createdAt])
}

model InterviewQuestion {
  id               String            @id @default(cuid())
  sessionId        String
  text             String
  hint             String?
  expectedKeywords String[]
  sortOrder        Int               @default(0)
  isFollowUp       Boolean           @default(false)
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer           InterviewAnswer?

  @@index([sessionId])
}

model InterviewAnswer {
  id         String            @id @default(cuid())
  questionId String            @unique
  answer     String            @db.Text
  score      Int
  feedback   String            @db.Text
  details    Json?             // LIVE: per-skill scores for this answer
  createdAt  DateTime          @default(now())
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ───────── Analyses & matching (demo providers for now) ─────────

model ResumeAnalysis {
  id                String   @id @default(cuid())
  userId            String
  resumeId          String?
  score             Int
  sections          Json
  strengths         String[]
  weaknesses        String[]
  suggestions       String[]
  keywordsFound     String[]
  keywordsSuggested String[]
  provider          String   @default("mock")
  isDemo            Boolean  @default(true)
  // Full structured report from the analyzer (sections, grammar, rewrites, ...). Null on old demo rows.
  details           Json?
  sourceType        String   @default("builder") // builder | file | text
  model             String?
  inputHash         String? // hash of the analysed text: same text = reuse the saved result
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume            Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, inputHash])
}

model ATSAnalysis {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobId            String?
  score            Int
  matchedKeywords  String[]
  missingKeywords  String[]
  checks           Json
  recommendations  String[]
  provider         String   @default("mock")
  isDemo           Boolean  @default(true)
  // Full structured report (score breakdown, related keywords, experience/education match, resume changes)
  details          Json?
  jobTitle         String? // title/company used for this check (works for pasted job descriptions too)
  jobCompany       String?
  resumeSource     String   @default("builder") // builder | file | text
  jobSource        String   @default("job") // job | file | text
  model            String?
  inputHash        String? // hash of resume text + job text
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  job              Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, inputHash])
}

model JobMatch {
  id         String   @id @default(cuid())
  userId     String
  jobId      String
  overall    Int
  skills     Int
  experience Int
  education  Int
  location   Int
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// ───────── Media (Cloudinary metadata only; binaries never live in PostgreSQL) ─────────

model Media {
  id             String    @id @default(cuid())
  url            String
  publicId       String    @unique
  resourceType   String    @default("image")
  mimeType       String
  width          Int?
  height         Int?
  size           Int
  kind           MediaKind
  ownerId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  profileAvatars Profile[] @relation("ProfileAvatar")
  profileCovers  Profile[] @relation("ProfileCover")
  postMedia      PostMedia[]

  @@index([ownerId, kind])
}

// ───────── Network ─────────

// One row per pair of users. `pairKey` = the two user ids sorted and joined, so A->B and B->A can never both exist.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  pairKey     String           @unique
  status      ConnectionStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  respondedAt DateTime?
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([addresseeId, status, updatedAt])
  @@index([requesterId, status, updatedAt])
}

model Follow {
  id         String           @id @default(cuid())
  followerId String
  targetType FollowTargetType @default(USER)
  targetId   String
  createdAt  DateTime         @default(now())
  follower   User             @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([followerId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}


// ───────── Posts, reactions, comments ─────────

model Post {
  id           String         @id @default(cuid())
  authorId     String
  content      String?        @db.Text
  postType     PostType       @default(TEXT)
  visibility   PostVisibility @default(PUBLIC)
  // Optional typed attachments. Everything is validated server-side before it is stored.
  title        String?        // project / achievement headline
  linkUrl      String?        // http(s) only (see lib/safe-url.ts)
  jobId        String?        // JOB posts point at a real Job row
  sharedPostId String?        // a share is a new Post that points at the original
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  editedAt     DateTime?
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  job          Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sharedPost   Post?          @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: Cascade)
  shares       Post[]         @relation("PostShares")
  media        PostMedia[]
  reactions    PostReaction[]
  comments     Comment[]
  savedBy      SavedPost[]
  reports      ContentReport[]
  notifications Notification[]

  @@index([authorId, createdAt])
  @@index([createdAt, id])
  @@index([visibility, createdAt])
  @@index([sharedPostId])
  @@index([jobId])
}

// Only metadata lives here; the binary is on Cloudinary (see Media).
model PostMedia {
  id        String @id @default(cuid())
  postId    String
  mediaId   String @unique
  sortOrder Int    @default(0)
  alt       String?
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// One reaction per user per post. Changing a reaction updates the same row.
model PostReaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId])
}

// Comments nest ONE level only: a reply's parent must itself be a top-level comment (enforced in the service).
model Comment {
  id        String            @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String            @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  editedAt  DateTime?
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  reports   ContentReport[]
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId, createdAt])
}

model CommentReaction {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

// Saved jobs keep using SavedJob; this table is only for saved posts.
model SavedPost {
  id      String   @id @default(cuid())
  userId  String
  postId  String
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, savedAt])
}

model ContentReport {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  postId     String?
  commentId  String?
  reason     String
  details    String?          @db.Text
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
}

// ───────── Notifications ─────────

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  postId      String?
  commentId   String?
  jobId       String?
  conversationId String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
}

// ───────── Messaging (private 1:1 conversations) ─────────

// One conversation per pair of users. `pairKey` = the two user ids sorted and joined (same helper as Connection),
// so A->B and B->A can never create two conversations, even under a race.
model Conversation {
  id            String                    @id @default(cuid())
  pairKey       String                    @unique
  // Null until the first message is sent. Conversations nobody has written in are not listed.
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
  notifications Notification[]

  @@index([lastMessageAt, id])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  // Generated by the sender's browser. Makes a retried send idempotent (same clientId = same message).
  clientId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // Set when the recipient opens the conversation.
  readAt         DateTime?
  // Soft delete: the row stays so the timeline keeps its shape, but `content` is blanked.
  deletedAt      DateTime?
  // Set each time the sender edits the text.
  editedAt       DateTime?
  replyToId      String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  reactions      MessageReaction[]
  hiddenFor      MessageHidden[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, readAt])
}

// One reaction per user per message (same ReactionType set as posts/comments).
model MessageReaction {
  id        String       @id @default(cuid())
  messageId String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// "Delete for me": a per-user hide. The message row is untouched, so the other person still sees it.
model MessageHidden {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ───────── Email sign-up verification ─────────
// A password sign-up lives HERE until the emailed code is confirmed; only then is a real User created.
// So an unverified email can never sign in, and existing accounts are unaffected.
model PendingSignup {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  // HMAC of the 6-digit code (never the code itself)
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0)
  lastSentAt    DateTime @default(now())
  sendCount     Int      @default(1)
  createdAt     DateTime @default(now())
  // The whole pending record is purged after this, even if the code was never used.
  expiresAt     DateTime

  @@index([expiresAt])
}

// ───────── Featured content (admin-ready; algorithmic fallback lives in the service) ─────────

model FeaturedItem {
  id         String           @id @default(cuid())
  category   FeaturedCategory
  targetId   String           // job id, post id, user id, company name, skill name ... depending on category
  title      String?
  priority   Int              @default(0)
  status     FeaturedStatus   @default(DRAFT)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([category, status, priority])
}

// ───────── Job alerts ─────────

model JobAlert {
  id              String           @id @default(cuid())
  userId          String
  keyword         String?
  location        String?
  skills          String[]
  workArrangement WorkArrangement?
  employmentType  EmploymentType?
  experienceLevel ExperienceLevel?
  minSalary       Int?             // monthly, same unit as Job.salaryMin/Max
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}
