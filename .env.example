# Neon: use the POOLED connection string here (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon: use the DIRECT (non-pooled) connection string here. Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Later, only when you choose providers:
# JOB_API_KEY=
# AI_API_KEY=

# ── Social sign-in (optional). A button appears ONLY when both values of a provider are set. ──
# Callback URLs to register with each provider (replace the host in production):
#   Google:   http://localhost:3000/api/auth/callback/google
#   GitHub:   http://localhost:3000/api/auth/callback/github
#   Facebook: http://localhost:3000/api/auth/callback/facebook
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
